// МОДУЛЬ ФОРМЫ: Расширение → ЗаказКлиента → Формы → ФормаДокумента → Модуль
// Заменить ВЕСЬ код модуля формы на этот файл.

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Б24_СформироватьКП(Команда)
	Б24КП_Клиент.СформироватьКП(ЭтотОбъект);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
&После("ПриСозданииНаСервере")
Процедура Б24_ПослеПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// 1. Скрыть только типовой «Статус» (Объект.Статус), не наше поле стадии
	ПолеСтатус = Элементы.Найти("Статус");
	Если ПолеСтатус <> Неопределено И ПолеСтатус.ПутьКДанным = "Объект.Статус" Тогда
		ПолеСтатус.Видимость = Ложь;
	КонецЕсли;

	// 2. Поле «Стадия» — свой список Б24_*, не 3 типовых
	Б24_НастроитьПолеСтадии();

	// 3. Старые заказы: подтянуть стадию из текущего состояния
	Б24_ЗаполнитьСтатусКанбанаИзСостояния();

КонецПроцедуры

// Если элемент назван «Статус», но привязан к Б24Д_Статус — перехватываем типовой список из 3 пунктов
&НаКлиенте
&Вместо("СтатусНачалоВыбора")
Процедура Б24_ВместоСтатусНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	Если Б24_ЭтоПолеСтадииКанбана(Элемент) Тогда
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;

	ПродолжитьВызов(Элемент, ДанныеВыбора, СтандартнаяОбработка);

КонецПроцедуры

&НаКлиенте
Процедура Б24Д_СтатусНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	// Список уже в Элемент.СписокВыбора (заполнен в ПриСозданииНаСервере)
	СтандартнаяОбработка = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура Б24Д_СтатусПриИзменении(Элемент)
	// Регистр обновим после «Записать» — см. Б24_ПослеПослеЗаписиНаСервере
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция Б24_ЭтоПолеСтадииКанбана(Элемент)

	Если Элемент = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Элемент.ПутьКДанным = "Объект.Б24Д_Статус";

КонецФункции

&НаСервере
Процедура Б24_НастроитьПолеСтадии()

	Поле = Б24_НайтиПолеСтадии();
	Если Поле = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Поле.РежимВыбораИзСписка = Истина;
	Поле.СписокВыбора.Очистить();
	Б24_ЗаполнитьСписокВыбораСтадий(Поле.СписокВыбора);

	Поле.УстановитьДействие("ПриИзменении", "Б24Д_СтатусПриИзменении");
	Поле.УстановитьДействие("НачалоВыбора", "Б24Д_СтатусНачалоВыбора");

КонецПроцедуры

&НаСервере
Функция Б24_НайтиПолеСтадии()

	// Имена, которые могут быть у поля на форме
	ИменаЭлементов = Новый Массив;
	ИменаЭлементов.Добавить("Б24Д_Статус");
	ИменаЭлементов.Добавить("СтатусКанбана");

	Для Каждого ИмяЭлемента Из ИменаЭлементов Цикл
		Поле = Элементы.Найти(ИмяЭлемента);
		Если Поле <> Неопределено Тогда
			Возврат Поле;
		КонецЕсли;
	КонецЦикла;

	Для Каждого ЭлементФормы Из Элементы Цикл

		Если ТипЗнч(ЭлементФормы) <> Тип("ПолеФормы") Тогда
			Продолжить;
		КонецЕсли;

		Если ЭлементФормы.ПутьКДанным = "Объект.Б24Д_Статус" Тогда
			Возврат ЭлементФормы;
		КонецЕсли;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

&НаСервере
Процедура Б24_ЗаполнитьСписокВыбораСтадий(СписокВыбора)

	// Порядок колонок канбана B24 (все 20)
	ИменаПоПорядку = Новый Массив;
	ИменаПоПорядку.Добавить("Б24_Новый");
	ИменаПоПорядку.Добавить("Б24_КОбработке");
	ИменаПоПорядку.Добавить("Б24_ВРаботеОЗ");
	ИменаПоПорядку.Добавить("Б24_ПросчетТранспорта");
	ИменаПоПорядку.Добавить("Б24_Обработано");
	ИменаПоПорядку.Добавить("Б24_СметаКП");
	ИменаПоПорядку.Добавить("Б24_НаСогласовании");
	ИменаПоПорядку.Добавить("Б24_НетТовара");
	ИменаПоПорядку.Добавить("Б24_ОтказПоЦене");
	ИменаПоПорядку.Добавить("Б24_КВыполнению");
	ИменаПоПорядку.Добавить("Б24_ЗаказанУПоставщика");
	ИменаПоПорядку.Добавить("Б24_ПереданоВЛогистикуСЗавода");
	ИменаПоПорядку.Добавить("Б24_ТоварВПути");
	ИменаПоПорядку.Добавить("Б24_ТоварНаСкладе");
	ИменаПоПорядку.Добавить("Б24_ПереданоВЛогистикуСоСклада");
	ИменаПоПорядку.Добавить("Б24_ВыписатьДокументы");
	ИменаПоПорядку.Добавить("Б24_ОтгруженЧастично");
	ИменаПоПорядку.Добавить("Б24_ОтгруженПолностью");
	ИменаПоПорядку.Добавить("Б24_Закрыт");
	ИменаПоПорядку.Добавить("Б24_ЗимнееХранение");

	Для Каждого Имя Из ИменаПоПорядку Цикл
		Б24_ДобавитьВСписокСтадий(СписокВыбора, Имя);
	КонецЦикла;

	// Остальные Б24_* из метаданных (если добавите ещё стадии)
	Для Каждого МетаЗначение Из Метаданные.Перечисления.СтатусыЗаказовКлиентов.ЗначенияПеречисления Цикл

		Если НЕ СтрНачинаетсяС(МетаЗначение.Имя, "Б24_") Тогда
			Продолжить;
		КонецЕсли;

		Значение = Б24_ЗначениеСтатусаПоИмени(МетаЗначение.Имя);
		Если НЕ ЗначениеЗаполнено(Значение) Тогда
			Продолжить;
		КонецЕсли;

		Если СписокВыбора.НайтиПоЗначению(Значение) = Неопределено Тогда
			СписокВыбора.Добавить(Значение, МетаЗначение.Синоним);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура Б24_ДобавитьВСписокСтадий(СписокВыбора, Имя)

	Значение = Б24_ЗначениеСтатусаПоИмени(Имя);
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат;
	КонецЕсли;

	Если СписокВыбора.НайтиПоЗначению(Значение) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	МетаЗначение = Метаданные.Перечисления.СтатусыЗаказовКлиентов.ЗначенияПеречисления.Найти(Имя);
	Синоним = ?(МетаЗначение = Неопределено, Имя, МетаЗначение.Синоним);
	СписокВыбора.Добавить(Значение, Синоним);

КонецПроцедуры

&НаСервере
Функция Б24_ЗначениеСтатусаПоИмени(Имя)

	Попытка
		Возврат Перечисления.СтатусыЗаказовКлиентов[Имя];
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

&НаСервере
Процедура Б24_ЗаполнитьСтатусКанбанаИзСостояния()

	Если ЗначениеЗаполнено(Объект.Б24Д_Статус) Тогда
		Возврат;
	КонецЕсли;

	Объект.Б24Д_Статус = Б24_СинхронизацияСервер.СтатусКанбанаПоТекущемуСостоянию(Объект.Ссылка);

КонецПроцедуры

&НаКлиенте
Процедура Б24_ОбновитьОтображениеСостояния()

	ЭтаФорма.ОбновитьОтображениеДанных();

КонецПроцедуры

&НаСервере
&После("ПослеЗаписиНаСервере")
Процедура Б24_ПослеПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// Регистр обновляет подписка Б24_ЗаказПриЗаписи — здесь не дублируем (иначе петля с коннектором).

КонецПроцедуры

&НаКлиенте
&После("ПослеЗаписи")
Процедура Б24_ПослеПослеЗаписи(ПараметрыЗаписи)

	ТекстДиагностики = Б24_ТекстДиагностикиСтадииНаСервере();
	Если НЕ ПустаяСтрока(ТекстДиагностики) Тогда
		ПоказатьОповещениеПользователя("Стадия канбана", , ТекстДиагностики);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция Б24_ТекстДиагностикиСтадииНаСервере()

	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Или НЕ ЗначениеЗаполнено(Объект.Б24Д_Статус) Тогда
		Возврат "";
	КонецЕсли;

	Возврат Б24_СинхронизацияСервер.ТекстДиагностикиСтадии(Объект.Ссылка, Объект.Б24Д_Статус);

КонецФункции

&НаСервереБезКонтекста
Процедура Б24_ПрименитьСтатусКанбанаНаСервере(ЗаказСсылка, СтатусКанбана)

	Б24_СинхронизацияСервер.ПриИзмененииСтатусаКанбана(ЗаказСсылка, СтатусКанбана);

КонецПроцедуры

#КонецОбласти
