///////////////////////////////////////////////////////////////////////////////////////////////////////
// Общий модуль Б24_СтатусыСервер (Сервер, Привилегированный).
// Состояние заказа (авто) → Статус канбана (20) = стадия B24 (1:1 через коннектор).
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Подписка: РегистрСведенийНаборЗаписей.СостоянияЗаказовКлиентов → ПриЗаписи.
Процедура СинхронизироватьСтатусПоСостоянию(Источник, Отказ, Замещение) Экспорт
	
	Если ТипЗнч(Источник) <> Тип("РегистрСведенийНаборЗаписей.СостоянияЗаказовКлиентов") Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Запись Из Источник Цикл
		
		Если НЕ ЗначениеЗаполнено(Запись.Заказ) Тогда
			Продолжить;
		КонецЕсли;
		
		НовыйСтатус = СтатусКанбанаПоСостоянию(Запись.Состояние);
		Если НЕ ЗначениеЗаполнено(НовыйСтатус) Тогда
			Продолжить;
		КонецЕсли;
		
		УстановитьСтатусКанбанаНаЗаказе(Запись.Заказ, НовыйСтатус);
		
	КонецЦикла;
	
КонецПроцедуры

// Ручная смена «Статус канбана» на форме.
Процедура ПриИзмененииСтатусаКанбана(ЗаказСсылка, НовыйСтатус) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ЗаказСсылка) Или НЕ ЗначениеЗаполнено(НовыйСтатус) Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьСтатусКанбанаНаЗаказе(ЗаказСсылка, НовыйСтатус);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СтатусКанбанаПоСостоянию(Состояние)
	
	// 11 системных состояний УТ → статусы канбана (остальные 9 — вручную на форме).
	Соответствие = Новый Соответствие;
	Соответствие.Вставить(Перечисления.СостоянияЗаказовКлиентов.ОжидаетсяСогласование,
		Перечисления.Б24_СтатусыКанбана.Новый);
	Соответствие.Вставить(Перечисления.СостоянияЗаказовКлиентов.ОжидаетсяАвансДоОбеспечения,
		Перечисления.Б24_СтатусыКанбана.НаСогласовании);
	Соответствие.Вставить(Перечисления.СостоянияЗаказовКлиентов.ГотовКОбеспечению,
		Перечисления.Б24_СтатусыКанбана.КВыполнению);
	Соответствие.Вставить(Перечисления.СостоянияЗаказовКлиентов.ОжидаетсяПредоплатаДоОтгрузки,
		Перечисления.Б24_СтатусыКанбана.СметаКП);
	Соответствие.Вставить(Перечисления.СостоянияЗаказовКлиентов.ОжидаетсяОбеспечение,
		Перечисления.Б24_СтатусыКанбана.ЗаказанУПоставщика);
	Соответствие.Вставить(Перечисления.СостоянияЗаказовКлиентов.ГотовКОтгрузке,
		Перечисления.Б24_СтатусыКанбана.ТоварНаСкладе);
	Соответствие.Вставить(Перечисления.СостоянияЗаказовКлиентов.ВПроцессеОтгрузки,
		Перечисления.Б24_СтатусыКанбана.ТоварВПути);
	Соответствие.Вставить(Перечисления.СостоянияЗаказовКлиентов.ОжидаетсяОплатаПослеОтгрузки,
		Перечисления.Б24_СтатусыКанбана.ОтгруженЧастично);
	Соответствие.Вставить(Перечисления.СостоянияЗаказовКлиентов.ГотовКЗакрытию,
		Перечисления.Б24_СтатусыКанбана.ВыписатьДокументы);
	Соответствие.Вставить(Перечисления.СостоянияЗаказовКлиентов.Закрыт,
		Перечисления.Б24_СтатусыКанбана.Закрыт);
	Соответствие.Вставить(Перечисления.СостоянияЗаказовКлиентов.ОжидаетсяПереходПраваСобственности,
		Перечисления.Б24_СтатусыКанбана.ЗимнееХранение);
	
	Возврат Соответствие.Получить(Состояние);
	
КонецФункции

Процедура УстановитьСтатусКанбанаНаЗаказе(ЗаказСсылка, СтатусКанбана)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ЗаказОбъект = ЗаказСсылка.ПолучитьОбъект();
	Если ЗаказОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗаказОбъект.Б24_СтатусКанбана = СтатусКанбана Тогда
		Возврат;
	КонецЕсли;
	
	ЗаказОбъект.Б24_СтатусКанбана = СтатусКанбана;
	ЗаказОбъект.Записать(РежимЗаписиДокумента.Запись);
	
	// Стадию в B24 выгрузит типовой коннектор при следующем обмене (маппинг доп. реквизита).
	
КонецПроцедуры

#КонецОбласти
