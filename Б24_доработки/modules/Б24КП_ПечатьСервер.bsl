///////////////////////////////////////////////////////////////////////////////////////////////////////
// Общий модуль Б24КП_ПечатьСервер (Server).
// Формирование табличного документа «Коммерческое предложение» из Заказа клиента.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

Функция СформироватьКоммерческоеПредложение(ЗаказКлиента) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ЗаказКлиента) Тогда
		ВызватьИсключение "Не указан заказ клиента для формирования КП.";
	КонецЕсли;
	
	ИмяПФ = СокрЛП(Константы.Б24КП_ИмяПечатнойФормыКП.Получить());
	Если НЕ ЗначениеЗаполнено(ИмяПФ) Тогда
		ИмяПФ = "КоммерческоеПредложение";
	КонецЕсли;
	
	ПечатнаяФорма = ПопыткаСформироватьШтатнуюПечатнуюФорму(ЗаказКлиента, ИмяПФ);
	
	Если ПечатнаяФорма = Неопределено Тогда
		ПечатнаяФорма = СформироватьТабличныйДокументКП(ЗаказКлиента);
	КонецЕсли;
	
	Если ПечатнаяФорма = Неопределено Или ПечатнаяФорма.ВысотаТаблицы = 0 Тогда
		ВызватьИсключение "Пустая печатная форма коммерческого предложения.";
	КонецЕсли;
	
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЗаказКлиента, "Номер, Дата");
	Название = СтрШаблон(
		"Коммерческое предложение № %1 от %2",
		СокрЛП(Строка(Реквизиты.Номер)),
		Формат(Реквизиты.Дата, "ДЛФ=DD"));
	
	Результат = Новый Структура;
	Результат.Вставить("ПечатнаяФорма", ПечатнаяФорма);
	Результат.Вставить("НазваниеПечатнойФормы", Название);
	
	Возврат Результат;
	
КонецФункции

Функция ТабличныйДокументВPDF(ПечатнаяФорма) Экспорт
	
	Если ПечатнаяФорма = Неопределено Тогда
		ВызватьИсключение "Не передан табличный документ для конвертации в PDF.";
	КонецЕсли;
	
	Поток = Новый ПотокВПамяти;
	ПечатнаяФорма.Записать(Поток, ТипФайлаТабличногоДокумента.PDF);
	Возврат Поток.ЗакрытьИПолучитьДвоичныеДанные();
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПопыткаСформироватьШтатнуюПечатнуюФорму(ЗаказКлиента, ИмяПФ)
	
	Попытка
		
		Если Метаданные.ОбщиеМодули.Найти("УправлениеПечатью") = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		МодульПечати = ОбщегоНазначения.ОбщийМодуль("УправлениеПечатью");
		
		МассивОбъектов = Новый Массив;
		МассивОбъектов.Добавить(ЗаказКлиента);
		
		ПараметрыПечати = Новый Структура;
		КоллекцияПечатныхФорм = Неопределено;
		
		Попытка
			КоллекцияПечатныхФорм = МодульПечати.СформироватьПечатныеФормы(
				"Документ.ЗаказКлиента",
				ИмяПФ,
				МассивОбъектов,
				ПараметрыПечати);
		Исключение
			Возврат Неопределено;
		КонецПопытки;
		
		Если КоллекцияПечатныхФорм = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Если ТипЗнч(КоллекцияПечатныхФорм) = Тип("ТаблицаЗначений") Тогда
			
			Если КоллекцияПечатныхФорм.Количество() = 0 Тогда
				Возврат Неопределено;
			КонецЕсли;
			
			Если КоллекцияПечатныхФорм.Колонки.Найти("ТабличныйДокумент") <> Неопределено Тогда
				Возврат КоллекцияПечатныхФорм[0].ТабличныйДокумент;
			КонецЕсли;
			
		КонецЕсли;
		
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат Неопределено;
	
КонецФункции

Функция СформироватьТабличныйДокументКП(ЗаказКлиента)
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.АвтоМасштаб = Истина;
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДок.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_Б24КП_КоммерческоеПредложение";
	
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		ЗаказКлиента,
		"Номер, Дата, Организация, Контрагент, Партнер, Валюта, СуммаДокумента, Менеджер, Комментарий");
	
	ТабДок.Область("R1C1:R1C6").Объединить();
	ТабДок.Область("R1C1").Текст = "КОММЕРЧЕСКОЕ ПРЕДЛОЖЕНИЕ";
	ТабДок.Область("R1C1").Шрифт = Новый Шрифт(, 16, Истина);
	ТабДок.Область("R1C1").ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	
	ТабДок.Область("R2C1:R2C6").Объединить();
	ТабДок.Область("R2C1").Текст = СтрШаблон(
		"к заказу клиента № %1 от %2",
		СокрЛП(Строка(Реквизиты.Номер)),
		Формат(Реквизиты.Дата, "ДЛФ=DD"));
	ТабДок.Область("R2C1").ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	
	ТабДок.Область("R4C1").Текст = "Организация:";
	ТабДок.Область("R4C2:R4C6").Объединить();
	ТабДок.Область("R4C2").Текст = Строка(Реквизиты.Организация);
	
	ТабДок.Область("R5C1").Текст = "Клиент:";
	ТабДок.Область("R5C2:R5C6").Объединить();
	ПредставлениеКлиента = ?(ЗначениеЗаполнено(Реквизиты.Контрагент),
		Строка(Реквизиты.Контрагент),
		Строка(Реквизиты.Партнер));
	ТабДок.Область("R5C2").Текст = ПредставлениеКлиента;
	
	ИНН = "";
	Если ЗначениеЗаполнено(Реквизиты.Контрагент) Тогда
		ИНН = СокрЛП(Строка(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Реквизиты.Контрагент, "ИНН")));
	КонецЕсли;
	
	ТабДок.Область("R6C1").Текст = "ИНН:";
	ТабДок.Область("R6C2").Текст = ?(ЗначениеЗаполнено(ИНН), ИНН, "—");
	
	ТабДок.Область("R7C1").Текст = "Менеджер:";
	ТабДок.Область("R7C2:R7C6").Объединить();
	ТабДок.Область("R7C2").Текст = Строка(Реквизиты.Менеджер);
	
	НомерСтрокиТаблицы = 9;
	ТабДок.Область(НомерСтрокиТаблицы, 1).Текст = "№";
	ТабДок.Область(НомерСтрокиТаблицы, 2).Текст = "Номенклатура";
	ТабДок.Область(НомерСтрокиТаблицы, 3).Текст = "Кол-во";
	ТабДок.Область(НомерСтрокиТаблицы, 4).Текст = "Ед.";
	ТабДок.Область(НомерСтрокиТаблицы, 5).Текст = "Цена";
	ТабДок.Область(НомерСтрокиТаблицы, 6).Текст = "Сумма";
	
	Для Колонка = 1 По 6 Цикл
		Ячейка = ТабДок.Область(НомерСтрокиТаблицы, Колонка);
		Ячейка.Шрифт = Новый Шрифт(, , Истина);
		Ячейка.ГраницаСверху = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
		Ячейка.ГраницаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
		Ячейка.ГраницаСлева = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
		Ячейка.ГраницаСправа = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
	КонецЦикла;
	
	Товары = ПолучитьТоварыЗаказа(ЗаказКлиента);
	НомерСтроки = 0;
	ТекущаяСтрока = НомерСтрокиТаблицы;
	
	Для Каждого СтрокаТовара Из Товары Цикл
		
		НомерСтроки = НомерСтроки + 1;
		ТекущаяСтрока = ТекущаяСтрока + 1;
		
		ТабДок.Область(ТекущаяСтрока, 1).Текст = Формат(НомерСтроки, "ЧГ=");
		ТабДок.Область(ТекущаяСтрока, 2).Текст = Строка(СтрокаТовара.Номенклатура)
			+ ?(ЗначениеЗаполнено(СтрокаТовара.Характеристика), ", " + Строка(СтрокаТовара.Характеристика), "");
		ТабДок.Область(ТекущаяСтрока, 3).Текст = Формат(СтрокаТовара.Количество, "ЧДЦ=3; ЧН=0");
		ТабДок.Область(ТекущаяСтрока, 4).Текст = Строка(СтрокаТовара.ЕдиницаИзмерения);
		ТабДок.Область(ТекущаяСтрока, 5).Текст = Формат(СтрокаТовара.Цена, "ЧДЦ=2; ЧН=0,00");
		ТабДок.Область(ТекущаяСтрока, 6).Текст = Формат(СтрокаТовара.Сумма, "ЧДЦ=2; ЧН=0,00");
		
		Для Колонка = 1 По 6 Цикл
			Ячейка = ТабДок.Область(ТекущаяСтрока, Колонка);
			Ячейка.ГраницаСверху = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
			Ячейка.ГраницаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
			Ячейка.ГраницаСлева = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
			Ячейка.ГраницаСправа = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
		КонецЦикла;
		
	КонецЦикла;
	
	ТекущаяСтрока = ТекущаяСтрока + 2;
	ТабДок.Область(ТекущаяСтрока, 5).Текст = "Итого:";
	ТабДок.Область(ТекущаяСтрока, 5).Шрифт = Новый Шрифт(, , Истина);
	ТабДок.Область(ТекущаяСтрока, 6).Текст = Формат(Реквизиты.СуммаДокумента, "ЧДЦ=2; ЧН=0,00")
		+ " " + Строка(Реквизиты.Валюта);
	ТабДок.Область(ТекущаяСтрока, 6).Шрифт = Новый Шрифт(, , Истина);
	
	Если ЗначениеЗаполнено(Реквизиты.Комментарий) Тогда
		ТекущаяСтрока = ТекущаяСтрока + 2;
		ТабДок.Область(ТекущаяСтрока, 1).Текст = "Комментарий:";
		ТекущаяСтрока = ТекущаяСтрока + 1;
		ТабДок.Область(ТекущаяСтрока, 1, ТекущаяСтрока, 6).Объединить();
		ТабДок.Область(ТекущаяСтрока, 1).Текст = Строка(Реквизиты.Комментарий);
	КонецЕсли;
	
	ТекущаяСтрока = ТекущаяСтрока + 2;
	ТабДок.Область(ТекущаяСтрока, 1, ТекущаяСтрока, 6).Объединить();
	ТабДок.Область(ТекущаяСтрока, 1).Текст =
		"Документ сформирован из 1С:Управление торговлей. Не является офертой без подтверждения менеджера.";
	
	УстановитьШиринуКолонок(ТабДок);
	
	Возврат ТабДок;
	
КонецФункции

Функция ПолучитьТоварыЗаказа(ЗаказКлиента)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ЗаказКлиента);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Количество КАК Количество,
	|	Товары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	Товары.Упаковка КАК Упаковка,
	|	Товары.Цена КАК Цена,
	|	Товары.Сумма КАК Сумма,
	|	Товары.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	Таблица = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицы.Упаковка) И ЗначениеЗаполнено(СтрокаТаблицы.КоличествоУпаковок) Тогда
			СтрокаТаблицы.Количество = СтрокаТаблицы.КоличествоУпаковок;
			СтрокаТаблицы.ЕдиницаИзмерения = СтрокаТаблицы.Упаковка;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

Процедура УстановитьШиринуКолонок(ТабДок)
	
	ТабДок.Область(, 1, , 1).ШиринаКолонки = 5;
	ТабДок.Область(, 2, , 2).ШиринаКолонки = 45;
	ТабДок.Область(, 3, , 3).ШиринаКолонки = 12;
	ТабДок.Область(, 4, , 4).ШиринаКолонки = 10;
	ТабДок.Область(, 5, , 5).ШиринаКолонки = 14;
	ТабДок.Область(, 6, , 6).ШиринаКолонки = 16;
	
КонецПроцедуры

#КонецОбласти
