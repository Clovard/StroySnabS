///////////////////////////////////////////////////////////////////////////////////////////////////////
// Общий модуль Б24_СчетВызовСервера (Сервер, Вызов сервера).
// Вызов проверки даты с клиента (форма заказа, УправлениеПечатьюКлиент).
// Плюс: отправка счёта в таймлайн сделки B24 после успешной печати (как и с КП).
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

Функция ТекстОшибкиДатыПередСчетомСФаксимиле(ЗаказСсылка) Экспорт

	Возврат Б24_СчетСервер.ТекстОшибкиДатыПередСчетомСФаксимиле(ЗаказСсылка);

КонецФункции

Функция ЗаказКлиентаПоОбъектуПечати(ОбъектПечати) Экспорт

	Возврат Б24_СчетСервер.ЗаказКлиентаПоОбъектуПечати(ОбъектПечати);

КонецФункции

// Вызывается ПОСЛЕ типовой печати (ПродолжитьВызов уже отработал — окно печати у пользователя
// уже открыто). Если это была печать именно счёта (с факсимиле или обычного) — формирует ту же
// печатную форму ещё раз на сервере и отправляет PDF в таймлайн привязанной к заказу сделки B24,
// точно так же, как это делает кнопка «Сформировать КП».
//
// Молча ничего не делает (Обрабатывалось = Ложь), если это была печать не счёта, или если заказ
// не привязан к сделке B24 — это не ошибка пользователя, обычная печать не должна на это ругаться.
Функция ОтправитьСчетВТаймлайнЕслиЭтоСчет(ЗаказСсылка, ИмяМенеджераПечати, ИменаМакетов, МассивОбъектов, ПараметрыПечати) Экспорт

	Результат = Новый Структура("Обрабатывалось, Успех, ТекстСообщения", Ложь, Ложь, "");

	Если НЕ ЗначениеЗаполнено(ЗаказСсылка) Тогда
		Возврат Результат;
	КонецЕсли;

	Если НЕ Б24_СчетСервер.ЭтоПечатьСчета(ИменаМакетов, ИмяМенеджераПечати, Б24_ПервыйОбъектМассива(МассивОбъектов)) Тогда
		Возврат Результат;
	КонецЕсли;

	Если Метаданные.ОбщиеМодули.Найти("Б24КП_ИнтеграцияB24") = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Если НЕ Б24КП_ИнтеграцияB24.ЗаказСвязанСоСделкойB24(ЗаказСсылка) Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Обрабатывалось = Истина;

	Попытка
		КоллекцияПечатныхФорм = УправлениеПечатью.СформироватьПечатныеФормы(
			ИмяМенеджераПечати, ИменаМакетов, МассивОбъектов, ПараметрыПечати);
	Исключение
		Результат.ТекстСообщения = "Не удалось сформировать печатную форму счёта для отправки в Bitrix24: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписатьВЖурналСчета(Результат.ТекстСообщения, ЗаказСсылка);
		Возврат Результат;
	КонецПопытки;

	Если ТипЗнч(КоллекцияПечатныхФорм) <> Тип("ТаблицаЗначений") Или КоллекцияПечатныхФорм.Количество() = 0 Тогда
		Результат.ТекстСообщения = "Печатная форма счёта пуста — в Bitrix24 не отправлено.";
		Возврат Результат;
	КонецЕсли;

	Отправлено = 0;
	Ошибки = Новый Массив;

	Для Каждого СтрокаПФ Из КоллекцияПечатныхФорм Цикл

		Если СтрокаПФ.Колонки.Найти("ТабличныйДокумент") = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ПечатнаяФорма = СтрокаПФ.ТабличныйДокумент;
		Если ПечатнаяФорма = Неопределено Или ПечатнаяФорма.ВысотаТаблицы = 0 Тогда
			Продолжить;
		КонецЕсли;

		Название = Б24_НазваниеПечатнойФормыСчета(СтрокаПФ);

		Попытка
			РезультатB24 = Б24КП_ИнтеграцияB24.ОтправитьКПВСуществующуюСделку(ЗаказСсылка, ПечатнаяФорма, Название);
			Если РезультатB24.Успех Тогда
				Отправлено = Отправлено + 1;
			Иначе
				Ошибки.Добавить(Название + ": " + РезультатB24.ТекстОшибки);
			КонецЕсли;
		Исключение
			Ошибки.Добавить(Название + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

	КонецЦикла;

	Если Отправлено > 0 Тогда
		Результат.Успех = Истина;
		Результат.ТекстСообщения = ?(Отправлено = 1,
			"Счёт отправлен в таймлайн сделки Bitrix24.",
			СтрШаблон("Отправлено файлов в таймлайн Bitrix24: %1.", Отправлено));
	Иначе
		Результат.ТекстСообщения = "Не удалось отправить счёт в Bitrix24: " + СтрСоединить(Ошибки, "; ");
	КонецЕсли;

	Если Ошибки.Количество() > 0 Тогда
		ЗаписатьВЖурналСчета(СтрСоединить(Ошибки, Символы.ПС), ЗаказСсылка);
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Б24_НазваниеПечатнойФормыСчета(СтрокаПФ)

	ИменаКолонок = "Синоним,Название,Представление";

	Для Каждого ИмяКолонки Из СтрРазделить(ИменаКолонок, ",", Ложь) Цикл

		Если СтрокаПФ.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Значение = СокрЛП(Строка(СтрокаПФ[ИмяКолонки]));
		Если ЗначениеЗаполнено(Значение) Тогда
			Возврат Значение;
		КонецЕсли;

	КонецЦикла;

	Возврат "Счёт на оплату из 1С";

КонецФункции

Функция Б24_ПервыйОбъектМассива(МассивОбъектов)

	Если МассивОбъектов = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(МассивОбъектов) = Тип("Массив") Тогда
		Если МассивОбъектов.Количество() = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат МассивОбъектов[0];
	КонецЕсли;

	Возврат МассивОбъектов;

КонецФункции

Процедура ЗаписатьВЖурналСчета(Текст, ЗаказСсылка)

	ЗаписьЖурналаРегистрации(
		"Б24Счет.ТаймЛайн",
		УровеньЖурналаРегистрации.Предупреждение,
		,
		ЗаказСсылка,
		Текст);

КонецПроцедуры

#КонецОбласти
