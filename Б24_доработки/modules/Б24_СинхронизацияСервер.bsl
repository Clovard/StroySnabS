///////////////////////////////////////////////////////////////////////////////////////////////////////
// ОБЩИЙ МОДУЛЬ: Расширение → Общие модули → Б24_СинхронизацияСервер (только Сервер)
// Работает через реквизит Б24Д_Статус (20 стадий), типовой Статус не трогаем.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Записать B24-состояние в регистр по стадии (статус передаётся явно).
Процедура ЗаписатьСостояниеПоСтатусу(ЗаказСсылка, СтатусКанбана) Экспорт

	Если НЕ ЗначениеЗаполнено(ЗаказСсылка) Или НЕ ЗначениеЗаполнено(СтатусКанбана) Тогда
		Возврат;
	КонецЕсли;

	Состояние = СостояниеПоСтатусуКанбана(СтатусКанбана);
	Если НЕ ЗначениеЗаполнено(Состояние) Тогда
		Возврат;
	КонецЕсли;

	УстановитьСостояниеЗаказа(ЗаказСсылка, Состояние);

КонецПроцедуры

// Синхронизировать регистр по стадии на заказе (читает Б24Д_Статус из базы).
Процедура СинхронизироватьРегистрПоСтадииЗаказа(ЗаказСсылка) Экспорт

	ПрименитьСостояниеПоСтадииКанбана(ЗаказСсылка);

КонецПроцедуры

// С формы: менеджер сменил «Стадия канбана» — только регистр, заказ не трогаем.
Процедура ПриИзмененииСтатусаКанбана(ЗаказСсылка, СтатусКанбана) Экспорт

	Если НЕ ЗначениеЗаполнено(ЗаказСсылка) Или НЕ ЗначениеЗаполнено(СтатусКанбана) Тогда
		Возврат;
	КонецЕсли;

	УстановитьСостояниеЗаказа(ЗаказСсылка, СостояниеПоСтатусуКанбана(СтатусКанбана));

КонецПроцедуры

// После типового ОтразитьСостояниеЗаказа — вернуть состояние по сохранённой стадии.
Процедура ПрименитьСостояниеПоСтадииКанбана(Заказы) Экспорт

	Если Заказы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	МассивЗаказов = Б24_НормализоватьМассивЗаказов(Заказы);

	Для Каждого ЗаказСсылка Из МассивЗаказов Цикл

		СтатусКанбана = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаказСсылка, "Б24Д_Статус");
		Если НЕ ЗначениеЗаполнено(СтатусКанбана) Тогда
			Продолжить;
		КонецЕсли;

		Состояние = СостояниеПоСтатусуКанбана(СтатусКанбана);
		Если НЕ ЗначениеЗаполнено(Состояние) Тогда
			Продолжить;
		КонецЕсли;

		ТекущееСостояние = ТекущееСостояниеЗаказа(ЗаказСсылка);
		Если ТекущееСостояние = Состояние Тогда
			Продолжить;
		КонецЕсли;

		УстановитьСостояниеЗаказа(ЗаказСсылка, Состояние);

	КонецЦикла;

КонецПроцедуры

// С формы: старый заказ без стадии — показать по текущему состоянию.
Функция СтатусКанбанаПоТекущемуСостоянию(ЗаказСсылка) Экспорт

	Если НЕ ЗначениеЗаполнено(ЗаказСсылка) Тогда
		Возврат Неопределено;
	КонецЕсли;

	МенеджерЗаписи = РегистрыСведений.СостоянияЗаказовКлиентов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Заказ = ЗаказСсылка;
	МенеджерЗаписи.Прочитать();

	Если НЕ МенеджерЗаписи.Выбран() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат СтатусКанбанаПоСостоянию(МенеджерЗаписи.Состояние);

КонецФункции

// Подписка: ЗаказКлиента → ПередЗаписью — разруливание 1С↔B24
Процедура ЗаказПередЗаписьюСинхронизация(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт

	Если Источник = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// --- 1С → B24: менеджер сменил «Стадию» — запомнить для защиты от отката при импорте ---
	Если НЕ Источник.ОбменДанными.Загрузка Тогда

		Если НЕ ЗначениеЗаполнено(Источник.Ссылка) Или НЕ ЗначениеЗаполнено(Источник.Б24Д_Статус) Тогда
			Возврат;
		КонецЕсли;

		СтатусВБазе = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Ссылка, "Б24Д_Статус");
		Если Источник.Б24Д_Статус <> СтатусВБазе Тогда
			Б24_ОтметитьВыгрузкуСтадииИз1С(Источник.Ссылка, Источник.Б24Д_Статус, СтатусВБазе);
			// Регистр до записи документа — коннектор при выгрузке видит актуальное состояние
			ЗаписатьСостояниеПоСтатусу(Источник.Ссылка, Источник.Б24Д_Статус);
		КонецЕсли;

		Возврат;

	КонецЕсли;

	// --- B24 → 1С: импорт с портала ---
	Если НЕ ЗначениеЗаполнено(Источник.Ссылка) Тогда
		Возврат;
	КонецЕсли;

	Ожидание = Б24_ПолучитьВыгрузкуСтадииИз1С(Источник.Ссылка);
	Если Ожидание = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтатусИмпорта = Источник.Б24Д_Статус;

	// Выгрузка дошла — на портале уже наша стадия
	Если СтатусИмпорта = Ожидание.НовыйСтатус Тогда
		Б24_СнятьВыгрузкуСтадииИз1С(Источник.Ссылка);
		Возврат;
	КонецЕсли;

	// Портал пытается откатить старой стадией — держим новую из 1С
	Если СтатусИмпорта = Ожидание.ПредыдущийСтатус Тогда
		Источник.Б24Д_Статус = Ожидание.НовыйСтатус;
		Возврат;
	КонецЕсли;

	// На канбане B24 поставили другую стадию — принимаем B24
	Б24_СнятьВыгрузкуСтадииИз1С(Источник.Ссылка);

КонецПроцедуры

// Подписка: ЗаказКлиента → ПриЗаписи — главная точка синхронизации
Процедура ЗаказПриЗаписиСинхронизация(Источник, Отказ) Экспорт

	Если Источник = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Б24_ПропуститьСинхронизациюЗаказа(Источник) Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Источник.Ссылка) Тогда
		Возврат;
	КонецЕсли;

	// Коннектор B24 записал заказ при обмене
	Если Источник.ОбменДанными.Загрузка Тогда
		Б24_ОбработатьИмпортЗаказаИзB24(Источник);
	ИначеЕсли ЗначениеЗаполнено(Источник.Б24Д_Статус) Тогда
		// Статус берём с записываемого объекта — не из базы
		ЗаписатьСостояниеПоСтатусу(Источник.Ссылка, Источник.Б24Д_Статус);
		// 1С → B24: менеджер сменил «Стадию» — выгрузить на канбан (импорт не трогаем)
		Если Б24_ПолучитьВыгрузкуСтадииИз1С(Источник.Ссылка) <> Неопределено Тогда
			Б24_ЗапланироватьВыгрузкуСтадииВB24(Источник.Ссылка);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Фоновое задание: только выгрузка сделок на портал (без загрузки из B24).
Процедура Б24_ВыполнитьВыгрузкуСтадииВФоне(Параметры, АдресРезультата) Экспорт

	Если Параметры = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Настройка = Неопределено;
	Если ТипЗнч(Параметры) = Тип("Структура") И Параметры.Свойство("Настройка") Тогда
		Настройка = Параметры.Настройка;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Настройка) Тогда
		Настройка = Б24_ПолучитьНастройкуПодключенияB24();
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Настройка) Тогда
		Возврат;
	КонецЕсли;

	Б24_ВыполнитьВыгрузкуСделокКоннектора(Настройка);

КонецПроцедуры

// Подписка: СостоянияЗаказовКлиентов → ПриЗаписи
Процедура СостоянияЗаказовПриЗаписи(Источник, Отказ, Замещение) Экспорт

	Флаг = Ложь;
	Если Источник.ДополнительныеСвойства.Свойство("Б24_ИдетЗаписьСостоянияИзКода", Флаг) И Флаг Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Источник) <> Тип("РегистрСведенийНаборЗаписей.СостоянияЗаказовКлиентов") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Запись Из Источник Цикл

		Если НЕ ЗначениеЗаполнено(Запись.Заказ) Тогда
			Продолжить;
		КонецЕсли;

		// Состояние только что записали из стадии канбана — не откатывать
		Если Б24_СостояниеСоответствуетСтадии(Запись.Заказ, Запись.Состояние) Тогда
			Продолжить;
		КонецЕсли;

		// Коннектор B24 записал B24_* в регистр — подтянуть «Стадию» (только B24_*, не системные УТ)
		Если Б24_ЭтоСостояниеКанбана(Запись.Состояние) Тогда

			СтатусИзB24 = СтатусКанбанаПоСостоянию(Запись.Состояние);
			Если ЗначениеЗаполнено(СтатусИзB24) Тогда
				СохранитьСтатусКанбанаНаЗаказе(Запись.Заказ, СтатусИзB24);
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		// УТ пересчитал системное состояние — не затирать ручную стадию на заказе
		Если НЕ Б24_ЭтоСостояниеКанбана(Запись.Состояние) Тогда

			СтатусНаЗаказе = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Запись.Заказ, "Б24Д_Статус");
			Если ЗначениеЗаполнено(СтатусНаЗаказе) Тогда
				// Вернуть B24_* после типового пересчёта (ОтразитьСостояниеЗаказа / отложенное задание)
				ОжидаемоеСостояние = СостояниеПоСтатусуКанбана(СтатусНаЗаказе);
				Если ЗначениеЗаполнено(ОжидаемоеСостояние) И Запись.Состояние <> ОжидаемоеСостояние Тогда
					УстановитьСостояниеЗаказа(Запись.Заказ, ОжидаемоеСостояние);
				КонецЕсли;
				Продолжить;
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// В расширении нельзя «Перем» — кэш ожидания выгрузки в хранилище настроек.
Функция Б24_ИмяКэшаВыгрузкиСтадий()
	Возврат "Б24_ОжидаетВыгрузкуСтадии_v1";
КонецФункции

Функция Б24_КлючЗаказаВКэше(ЗаказСсылка)
	Возврат Строка(ЗаказСсылка.УникальныйИдентификатор());
КонецФункции

Функция Б24_ПолучитьКэшВыгрузкиСтадий()

	Кэш = ХранилищеОбщихНастроек.Загрузить("Б24Доработки", Б24_ИмяКэшаВыгрузкиСтадий());
	Если Кэш = Неопределено Или ТипЗнч(Кэш) <> Тип("Соответствие") Тогда
		Возврат Новый Соответствие;
	КонецЕсли;

	Возврат Кэш;

КонецФункции

Процедура Б24_ЗаписатьКэшВыгрузкиСтадий(Кэш)

	ХранилищеОбщихНастроек.Сохранить("Б24Доработки", Б24_ИмяКэшаВыгрузкиСтадий(), , , Кэш);

КонецПроцедуры

Процедура Б24_ОтметитьВыгрузкуСтадииИз1С(ЗаказСсылка, НовыйСтатус, ПредыдущийСтатус)

	Кэш = Б24_ПолучитьКэшВыгрузкиСтадий();
	Ожидание = Новый Структура("НовыйСтатус, ПредыдущийСтатус", НовыйСтатус, ПредыдущийСтатус);
	Кэш.Вставить(Б24_КлючЗаказаВКэше(ЗаказСсылка), Ожидание);
	Б24_ЗаписатьКэшВыгрузкиСтадий(Кэш);

КонецПроцедуры

Функция Б24_ПолучитьВыгрузкуСтадииИз1С(ЗаказСсылка)

	Кэш = Б24_ПолучитьКэшВыгрузкиСтадий();
	Возврат Кэш.Получить(Б24_КлючЗаказаВКэше(ЗаказСсылка));

КонецФункции

Процедура Б24_СнятьВыгрузкуСтадииИз1С(ЗаказСсылка)

	Если НЕ ЗначениеЗаполнено(ЗаказСсылка) Тогда
		Возврат;
	КонецЕсли;

	Кэш = Б24_ПолучитьКэшВыгрузкиСтадий();
	Кэш.Удалить(Б24_КлючЗаказаВКэше(ЗаказСсылка));
	Б24_ЗаписатьКэшВыгрузкиСтадий(Кэш);

КонецПроцедуры

// 1С → B24: поставить в очередь выгрузку только сделок (без импорта с портала).
Процедура Б24_ЗапланироватьВыгрузкуСтадииВB24(ЗаказСсылка)

	Если НЕ ЗначениеЗаполнено(ЗаказСсылка) Тогда
		Возврат;
	КонецЕсли;

	Если Метаданные.ОбщиеМодули.Найти("Б24_КС_ОбщегоНазначенияВызовСервера") = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Настройка = Б24_ПолучитьНастройкуПодключенияB24();
	Если НЕ ЗначениеЗаполнено(Настройка) Тогда
		Возврат;
	КонецЕсли;

	Параметры = Новый Структура("Настройка, Заказ", Настройка, ЗаказСсылка);

	Если Метаданные.ОбщиеМодули.Найти("ДлительныеОперации") <> Неопределено Тогда

		ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
		ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Б24: выгрузка стадии заказа";
		ПараметрыВыполнения.КлючФоновогоЗадания = "Б24Д_ВыгрузкаСтадии_" + Б24_КлючЗаказаВКэше(ЗаказСсылка);

		ДлительныеОперации.ВыполнитьВФоне(
			"Б24_СинхронизацияСервер.Б24_ВыполнитьВыгрузкуСтадииВФоне",
			Параметры,
			ПараметрыВыполнения);

	Иначе
		Б24_ВыполнитьВыгрузкуСделокКоннектора(Настройка);
	КонецЕсли;

КонецПроцедуры

Процедура Б24_ВыполнитьВыгрузкуСделокКоннектора(НастройкаПодключения)

	Если НЕ ЗначениеЗаполнено(НастройкаПодключения) Тогда
		Возврат;
	КонецЕсли;

	Если Метаданные.ОбщиеМодули.Найти("Б24_КС_ОбщегоНазначенияВызовСервера") = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Модуль = ОбщегоНазначения.ОбщийМодуль("Б24_КС_ОбщегоНазначенияВызовСервера");

	// ВыполнитьСинхронизацию(Настройка, Вид, Полная, Загрузка, Выгрузка) — только выгрузка
	Попытка
		Модуль.ВыполнитьСинхронизацию(НастройкаПодключения, Неопределено, Ложь, Ложь, Истина);
	Исключение
		ЗаписьЖурналаРегистрации(
			"Б24Доработки.ВыгрузкаСтадии",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			"Не удалось выгрузить стадию в B24: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

Функция Б24_ПолучитьНастройкуПодключенияB24()

	Если Метаданные.ОбщиеМодули.Найти("Б24_К_ОбщегоНазначенияВызовСервераПовтИсп") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	МодульB24 = ОбщегоНазначения.ОбщийМодуль("Б24_К_ОбщегоНазначенияВызовСервераПовтИсп");

	Если МодульB24.ПолучитьКоличествоНастроекПодключения() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат МодульB24.ПолучитьНастройкуПодключенияПоУмолчанию();

КонецФункции

Функция Б24_ПропуститьСинхронизациюЗаказа(ЗаказОбъект)

	Флаг = Ложь;
	Если ЗаказОбъект.ДополнительныеСвойства.Свойство("Б24_СинхронизацияИзКода", Флаг) Тогда
		Возврат Флаг = Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

Функция СостояниеПоСтатусуКанбана(СтатусКанбана)

	// Любая B24_* стадия → одноимённое состояние (все канбан-колонки)
	Состояние = Б24_СостояниеПоОдноименномуСтатусу(СтатусКанбана);
	Если ЗначениеЗаполнено(Состояние) Тогда
		Возврат Состояние;
	КонецЕсли;

	Соответствие = СоответствиеСтатусВСостояние();
	Результат = Соответствие.Получить(СтатусКанбана);
	Возврат ?(Результат = Неопределено, Неопределено, Результат);

КонецФункции

Функция СтатусКанбанаПоСостоянию(Состояние)

	// Любое B24_* состояние → одноимённая стадия
	Статус = Б24_СтатусПоОдноименномуСостоянию(Состояние);
	Если ЗначениеЗаполнено(Статус) Тогда
		Возврат Статус;
	КонецЕсли;

	// Переименованные в метаданных значения (синоним = колонка канбана)
	Статус = Б24_СтатусПоСинонимуСостояния(Состояние);
	Если ЗначениеЗаполнено(Статус) Тогда
		Возврат Статус;
	КонецЕсли;

	Соответствие = СоответствиеСостояниеВСтатус();
	Результат = Соответствие.Получить(Состояние);
	Возврат ?(Результат = Неопределено, Неопределено, Результат);

КонецФункции

// Статус (канбан) → состояние в регистре (ручная смена стадии)
Функция СоответствиеСтатусВСостояние()

	С = Новый Соответствие;
	Б24_ДобавитьВсеОдноименныеПарыСтатусСостояние(С);
	Б24_ДобавитьПару(С, "КВыполнению", "ГотовКОбеспечению");
	Б24_ДобавитьПару(С, "Закрыт", "Закрыт");
	Возврат С;

КонецФункции

// Состояние в регистре → стадия канбана (авто от УТ)
Функция СоответствиеСостояниеВСтатус()

	С = Новый Соответствие;

	// Все B24_* из метаданных — автоматически 1:1
	Б24_ДобавитьВсеОдноименныеПарыСостояниеСтатус(С);

	// Системные состояния УТ → ближайшая стадия канбана
	Б24_ДобавитьПаруСостояниеСтатус(С, "ОжидаетсяСогласование", "Б24_Новый");
	Б24_ДобавитьПаруСостояниеСтатус(С, "ОжидаетсяСогласование", "Б24_КОбработке");
	Б24_ДобавитьПаруСостояниеСтатус(С, "ОжидаетсяАвансДоОбеспечения", "Б24_НаСогласовании");
	Б24_ДобавитьПаруСостояниеСтатус(С, "ОжидаетсяАвансДоОбеспечения", "Б24_Обработано");
	Б24_ДобавитьПаруСостояниеСтатус(С, "ГотовКОбеспечению", "Б24_КВыполнению");
	Б24_ДобавитьПаруСостояниеСтатус(С, "ГотовКОбеспечению", "Б24_ВРаботеОЗ");
	Б24_ДобавитьПаруСостояниеСтатус(С, "ОжидаетсяПредоплатаДоОтгрузки", "Б24_СметаКП");
	Б24_ДобавитьПаруСостояниеСтатус(С, "ОжидаетсяОбеспечение", "Б24_ЗаказанУПоставщика");
	Б24_ДобавитьПаруСостояниеСтатус(С, "ОжидаетсяОбеспечение", "Б24_ПросчетТранспорта");
	Б24_ДобавитьПаруСостояниеСтатус(С, "ГотовКОтгрузке", "Б24_ТоварНаСкладе");
	Б24_ДобавитьПаруСостояниеСтатус(С, "ГотовКОтгрузке", "Б24_ПереданоВЛогистикуСЗавода");
	Б24_ДобавитьПаруСостояниеСтатус(С, "ВПроцессеОтгрузки", "Б24_ТоварВПути");
	Б24_ДобавитьПаруСостояниеСтатус(С, "ВПроцессеОтгрузки", "Б24_ПереданоВЛогистикуСоСклада");
	// Частичная / полная отгрузка, закрытие
	Б24_ДобавитьПаруСостояниеСтатус(С, "ОжидаетсяОплатаПослеОтгрузки", "Б24_ОтгруженЧастично");
	Б24_ДобавитьПаруСостояниеСтатус(С, "ГотовКЗакрытию", "Б24_ОтгруженПолностью");
	Б24_ДобавитьПаруСостояниеСтатус(С, "ГотовКЗакрытию", "Б24_ВыписатьДокументы");
	Б24_ДобавитьПаруСостояниеСтатус(С, "ГотовКЗакрытию", "Б24_НетТовара");
	Б24_ДобавитьПаруСостояниеСтатус(С, "ГотовКЗакрытию", "Б24_ЗимнееХранение");
	Б24_ДобавитьПаруСостояниеСтатус(С, "Закрыт", "Б24_Закрыт");
	Б24_ДобавитьПаруСостояниеСтатус(С, "Закрыт", "Закрыт");

	Возврат С;

КонецФункции

Функция Б24_ЗначениеСтатуса(ИмяЗначения)

	Попытка
		Возврат Перечисления.СтатусыЗаказовКлиентов[ИмяЗначения];
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Функция Б24_ЗначениеСостояния(ИмяЗначения)

	Попытка
		Возврат Перечисления.СостоянияЗаказовКлиентов[ИмяЗначения];
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Процедура Б24_ДобавитьПару(СоответствиеПар, ИмяСтатуса, ИмяСостояния)

	Статус = Б24_ЗначениеСтатуса(ИмяСтатуса);
	Состояние = Б24_ЗначениеСостояния(ИмяСостояния);

	Если ЗначениеЗаполнено(Статус) И ЗначениеЗаполнено(Состояние) Тогда
		СоответствиеПар.Вставить(Статус, Состояние);
	КонецЕсли;

КонецПроцедуры

Процедура Б24_ДобавитьПаруСостояниеСтатус(СоответствиеПар, ИмяСостояния, ИмяСтатуса)

	Состояние = Б24_ЗначениеСостояния(ИмяСостояния);
	Статус = Б24_ЗначениеСтатуса(ИмяСтатуса);

	Если ЗначениеЗаполнено(Состояние) И ЗначениеЗаполнено(Статус) Тогда
		СоответствиеПар.Вставить(Состояние, Статус);
	КонецЕсли;

КонецПроцедуры

Функция Б24_ЭтоСостояниеКанбана(Состояние)

	Имя = Б24_ИмяЗначенияПеречисления(Состояние, "СостоянияЗаказовКлиентов");
	Возврат СтрНачинаетсяС(Имя, "Б24_");

КонецФункции

// Канбан-стадия: B24_* по имени или любое значение с синонимом одной из 20 колонок.
Функция Б24_ЭтоИзвестнаяСтадияКанбана(Состояние)

	Если Б24_ЭтоСостояниеКанбана(Состояние) Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ЗначениеЗаполнено(Б24_СтатусПоСинонимуСостояния(Состояние));

КонецФункции

Функция Б24_СтатусПоСинонимуСостояния(Состояние)

	МетаСостояние = Б24_МетаЗначениеПеречисления(Состояние, "СостоянияЗаказовКлиентов");
	Если МетаСостояние = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	СинонимСостояния = МетаСостояние.Синоним;

	Для Каждого МетаСтатус Из Метаданные.Перечисления.СтатусыЗаказовКлиентов.ЗначенияПеречисления Цикл
		Если НЕ СтрНачинаетсяС(МетаСтатус.Имя, "Б24_") Тогда
			Продолжить;
		КонецЕсли;
		Если МетаСтатус.Синоним = СинонимСостояния Тогда
			Возврат Б24_ЗначениеСтатуса(МетаСтатус.Имя);
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Процедура Б24_ПодтянутьСтадиюНаЗаказИзРегистра(ЗаказСсылка)

	Если НЕ ЗначениеЗаполнено(ЗаказСсылка) Тогда
		Возврат;
	КонецЕсли;

	Состояние = ТекущееСостояниеЗаказа(ЗаказСсылка);
	Если НЕ ЗначениеЗаполнено(Состояние) Тогда
		Возврат;
	КонецЕсли;

	Если НЕ Б24_ЭтоИзвестнаяСтадияКанбана(Состояние) Тогда
		Возврат;
	КонецЕсли;

	Если Б24_СостояниеСоответствуетСтадии(ЗаказСсылка, Состояние) Тогда
		Возврат;
	КонецЕсли;

	СтатусИзB24 = СтатусКанбанаПоСостоянию(Состояние);
	Если ЗначениеЗаполнено(СтатусИзB24) Тогда
		СохранитьСтатусКанбанаНаЗаказе(ЗаказСсылка, СтатусИзB24);
	КонецЕсли;

КонецПроцедуры

// Коннектор при импорте сделки — только если реально изменилась стадия.
Процедура Б24_ОбработатьИмпортЗаказаИзB24(ЗаказОбъект)

	Если ЗаказОбъект = Неопределено Или НЕ ЗначениеЗаполнено(ЗаказОбъект.Ссылка) Тогда
		Возврат;
	КонецЕсли;

	ЗаказСсылка = ЗаказОбъект.Ссылка;
	ТекущийСтатус = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаказСсылка, "Б24Д_Статус");

	Если ЗаказОбъект.Б24Д_Статус = ТекущийСтатус Тогда
		Возврат;
	КонецЕсли;

	// B24 → 1С: новая стадия с портала — в регистр и снять ожидание выгрузки из 1С
	Б24_СнятьВыгрузкуСтадииИз1С(ЗаказСсылка);

	Если ЗначениеЗаполнено(ЗаказОбъект.Б24Д_Статус) Тогда
		ЗаписатьСостояниеПоСтатусу(ЗаказСсылка, ЗаказОбъект.Б24Д_Статус);
	КонецЕсли;

КонецПроцедуры

// Для ручной проверки в консоли: Б24_СинхронизацияСервер.ДиагностикаСтадииЗаказа(ЗаказСсылка)
Функция ДиагностикаСтадииЗаказа(ЗаказСсылка) Экспорт

	Если НЕ ЗначениеЗаполнено(ЗаказСсылка) Тогда
		Возврат "Заказ не указан";
	КонецЕсли;

	Статус = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаказСсылка, "Б24Д_Статус");
	Состояние = ТекущееСостояниеЗаказа(ЗаказСсылка);

	ИмяСтатуса = Б24_ИмяЗначенияПеречисления(Статус, "СтатусыЗаказовКлиентов");
	ИмяСостояния = Б24_ИмяЗначенияПеречисления(Состояние, "СостоянияЗаказовКлиентов");

	СинонимСтатуса = "";
	МетаСтатус = Б24_МетаЗначениеПеречисления(Статус, "СтатусыЗаказовКлиентов");
	Если МетаСтатус <> Неопределено Тогда
		СинонимСтатуса = МетаСтатус.Синоним;
	КонецЕсли;

	СинонимСостояния = "";
	МетаСостояние = Б24_МетаЗначениеПеречисления(Состояние, "СостоянияЗаказовКлиентов");
	Если МетаСостояние <> Неопределено Тогда
		СинонимСостояния = МетаСостояние.Синоним;
	КонецЕсли;

	Совпадает = Б24_СостояниеСоответствуетСтадии(ЗаказСсылка, Состояние);
	Канбан = Б24_ЭтоИзвестнаяСтадияКанбана(Состояние);

	Возврат "Стадия: " + ?(ПустаяСтрока(СинонимСтатуса), ИмяСтатуса, СинонимСтатуса)
		+ " (" + ИмяСтатуса + ")"
		+ "; Состояние: " + ?(ПустаяСтрока(СинонимСостояния), ИмяСостояния, СинонимСостояния)
		+ " (" + ИмяСостояния + ")"
		+ "; канбан=" + ?(Канбан, "да", "нет")
		+ "; совпадает=" + ?(Совпадает, "да", "нет");

КонецФункции

Функция Б24_ИмяЗначенияПеречисления(ЗначениеПеречисления, ИмяПеречисления)

	Если НЕ ЗначениеЗаполнено(ЗначениеПеречисления) Тогда
		Возврат "";
	КонецЕсли;

	МетаПеречисление = Метаданные.Перечисления.Найти(ИмяПеречисления);
	Если МетаПеречисление = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Для Каждого МетаЗначение Из МетаПеречисление.ЗначенияПеречисления Цикл
		Попытка
			Если Перечисления[ИмяПеречисления][МетаЗначение.Имя] = ЗначениеПеречисления Тогда
				Возврат МетаЗначение.Имя;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция Б24_СостояниеПоОдноименномуСтатусу(СтатусКанбана)

	Имя = Б24_ИмяЗначенияПеречисления(СтатусКанбана, "СтатусыЗаказовКлиентов");
	Если СтрНачинаетсяС(Имя, "Б24_") Тогда
		Состояние = Б24_ЗначениеСостояния(Имя);
		Если ЗначениеЗаполнено(Состояние) Тогда
			Возврат Состояние;
		КонецЕсли;
	КонецЕсли;

	// Имена в перечислениях могут отличаться — ищем по синониму
	Возврат Б24_СостояниеПоСинонимуСтатуса(СтатусКанбана);

КонецФункции

Функция Б24_СостояниеПоСинонимуСтатуса(СтатусКанбана)

	МетаСтатус = Б24_МетаЗначениеПеречисления(СтатусКанбана, "СтатусыЗаказовКлиентов");
	Если МетаСтатус = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	СинонимСтатуса = МетаСтатус.Синоним;

	Для Каждого МетаСостояние Из Метаданные.Перечисления.СостоянияЗаказовКлиентов.ЗначенияПеречисления Цикл
		Если МетаСостояние.Синоним = СинонимСтатуса Тогда
			Возврат Б24_ЗначениеСостояния(МетаСостояние.Имя);
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция Б24_МетаЗначениеПеречисления(ЗначениеПеречисления, ИмяПеречисления)

	Имя = Б24_ИмяЗначенияПеречисления(ЗначениеПеречисления, ИмяПеречисления);
	Если ПустаяСтрока(Имя) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления.Найти(Имя);

КонецФункции

Функция Б24_СтатусПоОдноименномуСостоянию(Состояние)

	Имя = Б24_ИмяЗначенияПеречисления(Состояние, "СостоянияЗаказовКлиентов");
	Если НЕ СтрНачинаетсяС(Имя, "Б24_") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Б24_ЗначениеСтатуса(Имя);

КонецФункции

Процедура Б24_ДобавитьВсеОдноименныеПарыСтатусСостояние(СоответствиеПар)

	Для Каждого МетаЗначение Из Метаданные.Перечисления.СтатусыЗаказовКлиентов.ЗначенияПеречисления Цикл
		Если НЕ СтрНачинаетсяС(МетаЗначение.Имя, "Б24_") Тогда
			Продолжить;
		КонецЕсли;
		Б24_ДобавитьПару(СоответствиеПар, МетаЗначение.Имя, МетаЗначение.Имя);
	КонецЦикла;

КонецПроцедуры

Процедура Б24_ДобавитьВсеОдноименныеПарыСостояниеСтатус(СоответствиеПар)

	Для Каждого МетаЗначение Из Метаданные.Перечисления.СостоянияЗаказовКлиентов.ЗначенияПеречисления Цикл
		Если НЕ СтрНачинаетсяС(МетаЗначение.Имя, "Б24_") Тогда
			Продолжить;
		КонецЕсли;
		Б24_ДобавитьПаруСостояниеСтатус(СоответствиеПар, МетаЗначение.Имя, МетаЗначение.Имя);
	КонецЦикла;

КонецПроцедуры

Процедура УстановитьСостояниеЗаказа(ЗаказСсылка, Состояние)

	Если НЕ ЗначениеЗаполнено(ЗаказСсылка) Или НЕ ЗначениеЗаполнено(Состояние) Тогда
		Возврат;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	// Нельзя Набор.Очистить() — в регистре суммы оплаты/отгрузки, их затирает УТ.
	// Меняем только ресурс «Состояние», остальное сохраняем (см. Infostart 1241827).
	Набор = РегистрыСведений.СостоянияЗаказовКлиентов.СоздатьНаборЗаписей();
	Набор.Отбор.Заказ.Установить(ЗаказСсылка);
	Набор.Прочитать();

	Если Набор.Количество() = 0 Тогда
		Запись = Набор.Добавить();
		Запись.Заказ = ЗаказСсылка;
		Запись.Состояние = Состояние;
	Иначе
		Для Каждого Запись Из Набор Цикл
			Если Запись.Состояние = Состояние Тогда
				Возврат;
			КонецЕсли;
			Запись.Состояние = Состояние;
		КонецЦикла;
	КонецЕсли;

	Набор.ДополнительныеСвойства.Вставить("Б24_ИдетЗаписьСостоянияИзКода", Истина);
	Набор.Записать(Истина);

КонецПроцедуры

Процедура СохранитьСтатусКанбанаНаЗаказе(ЗаказСсылка, СтатусКанбана)

	Если НЕ ЗначениеЗаполнено(ЗаказСсылка) Или НЕ ЗначениеЗаполнено(СтатусКанбана) Тогда
		Возврат;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	Текущий = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаказСсылка, "Б24Д_Статус");
	Если Текущий = СтатусКанбана Тогда
		Возврат;
	КонецЕсли;

	ЗаказОбъект = ЗаказСсылка.ПолучитьОбъект();
	Если ЗаказОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗаказОбъект.ДополнительныеСвойства.Вставить("Б24_СинхронизацияИзКода", Истина);
	ЗаказОбъект.ОбменДанными.Загрузка = Истина;
	ЗаказОбъект.Б24Д_Статус = СтатусКанбана;
	ЗаказОбъект.Записать(РежимЗаписиДокумента.Запись);

КонецПроцедуры

Функция ТекущееСостояниеЗаказа(ЗаказСсылка)

	МенеджерЗаписи = РегистрыСведений.СостоянияЗаказовКлиентов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Заказ = ЗаказСсылка;
	МенеджерЗаписи.Прочитать();

	Если МенеджерЗаписи.Выбран() Тогда
		Возврат МенеджерЗаписи.Состояние;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция Б24_СостояниеСоответствуетСтадии(ЗаказСсылка, Состояние)

	СтатусНаЗаказе = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаказСсылка, "Б24Д_Статус");
	Если НЕ ЗначениеЗаполнено(СтатусНаЗаказе) Тогда
		Возврат Ложь;
	КонецЕсли;

	ОжидаемоеСостояние = СостояниеПоСтатусуКанбана(СтатусНаЗаказе);
	Возврат ОжидаемоеСостояние = Состояние;

КонецФункции

Функция Б24_НормализоватьМассивЗаказов(Заказы)

	Результат = Новый Массив;

	Если ТипЗнч(Заказы) = Тип("Массив") Тогда
		Для Каждого Заказ Из Заказы Цикл
			Если ЗначениеЗаполнено(Заказ) Тогда
				Результат.Добавить(Заказ);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ЗначениеЗаполнено(Заказы) Тогда
		Результат.Добавить(Заказы);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Процедура УстановитьСтатусКанбанаНаЗаказе(ЗаказСсылка, СтатусКанбана)

	СохранитьСтатусКанбанаНаЗаказе(ЗаказСсылка, СтатусКанбана);

КонецПроцедуры

// Текст для диагностики: почему стадия не попала в регистр.
Функция ТекстДиагностикиСтадии(ЗаказСсылка, СтатусКанбана) Экспорт

	Если НЕ ЗначениеЗаполнено(СтатусКанбана) Тогда
		Возврат "Стадия не выбрана";
	КонецЕсли;

	Состояние = СостояниеПоСтатусуКанбана(СтатусКанбана);
	Если НЕ ЗначениеЗаполнено(Состояние) Тогда
		ИмяСтатуса = Б24_ИмяЗначенияПеречисления(СтатусКанбана, "СтатусыЗаказовКлиентов");
		Возврат "Нет пары в СостоянияЗаказовКлиентов для """ + ИмяСтатуса
			+ """ — добавьте такое же B24_* в перечисление состояний";
	КонецЕсли;

	ИмяСостояния = Б24_ИмяЗначенияПеречисления(Состояние, "СостоянияЗаказовКлиентов");
	Текущее = ТекущееСостояниеЗаказа(ЗаказСсылка);
	ТекущееИмя = Б24_ИмяЗначенияПеречисления(Текущее, "СостоянияЗаказовКлиентов");

	Возврат "Стадия → " + ИмяСостояния + ", в регистре сейчас: " + ?(ПустаяСтрока(ТекущееИмя), "(пусто)", ТекущееИмя);

КонецФункции

#КонецОбласти
