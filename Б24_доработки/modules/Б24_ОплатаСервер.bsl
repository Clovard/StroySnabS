///////////////////////////////////////////////////////////////////////////////////////////////////////
// Общий модуль Б24_ОплатаСервер (Сервер, Привилегированный).
// Дата фактической оплаты с заказа → дата платёжного документа.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Подписка ПередЗаписью: ПоступлениеБезналичныхДенежныхСредств, ПриходныйКассовыйОрдер.
Процедура ПодставитьДатуОплатыИзЗаказа(ДокументОбъект, Отказ) Экспорт
	
	Если ДокументОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Заказ = ЗаказКлиентаИзПлатежногоДокумента(ДокументОбъект);
	Если НЕ ЗначениеЗаполнено(Заказ) Тогда
		Возврат;
	КонецЕсли;
	
	ДатаОплаты = ДатаФактОплатыПоЗаказу(Заказ);
	Если НЕ ЗначениеЗаполнено(ДатаОплаты) Тогда
		Возврат;
	КонецЕсли;
	
	// Дата документа = дата, которую указал менеджер на заказе.
	ДокументОбъект.Дата = ДатаОплаты;
	
КонецПроцедуры

Функция ДатаФактОплатыПоЗаказу(ЗаказКлиента) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ЗаказКлиента) Тогда
		Возврат '00010101';
	КонецЕсли;
	
	Попытка
		Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаказКлиента, "Б24_ДатаФактОплаты");
	Исключение
		Возврат '00010101';
	КонецПопытки;
	
КонецФункции

Функция ЗаказКлиентаИзПлатежногоДокумента(ДокументОбъект) Экспорт
	
	Заказ = ЗаказИзОснованияПлатежа(ДокументОбъект);
	Если ЗначениеЗаполнено(Заказ) Тогда
		Возврат Заказ;
	КонецЕсли;
	
	ИмяТЧ = "РасшифровкаПлатежа";
	Если НЕ ОбщегоНазначения.ЕстьРеквизитИлиСвойствоОбъекта(ДокументОбъект, ИмяТЧ) Тогда
		Возврат Документы.ЗаказКлиента.ПустаяСсылка();
	КонецЕсли;
	
	Для Каждого Строка Из ДокументОбъект[ИмяТЧ] Цикл
		
		Если НЕ ОбщегоНазначения.ЕстьРеквизитИлиСвойствоОбъекта(Строка, "ОснованиеПлатежа") Тогда
			Продолжить;
		КонецЕсли;
		
		Заказ = ЗаказИзОснованияПлатежа(Строка.ОснованиеПлатежа);
		Если ЗначениеЗаполнено(Заказ) Тогда
			Возврат Заказ;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Документы.ЗаказКлиента.ПустаяСсылка();
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗаказИзОснованияПлатежа(Основание)
	
	Если НЕ ЗначениеЗаполнено(Основание) Тогда
		Возврат Документы.ЗаказКлиента.ПустаяСсылка();
	КонецЕсли;
	
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
		Возврат Основание;
	КонецЕсли;
	
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.СчетНаОплатуКлиенту") Тогда
		
		Попытка
			Заказ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Основание, "ДокументОснование");
			Если ТипЗнч(Заказ) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
				Возврат Заказ;
			КонецЕсли;
		Исключение
		КонецПопытки;
		
	КонецЕсли;
	
	// Универсально: у основания может быть реквизит ДокументОснование → заказ.
	Попытка
		Заказ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Основание, "ДокументОснование");
		Если ТипЗнч(Заказ) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
			Возврат Заказ;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Возврат Документы.ЗаказКлиента.ПустаяСсылка();
	
КонецФункции

#КонецОбласти
