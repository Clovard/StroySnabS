///////////////////////////////////////////////////////////////////////////////////////////////////////
// Общий модуль Б24КП_ВызовСервера (Server, CallServer).
// Оркестрация: PDF КП + выгрузка в Bitrix24 по сценарию ИНН.
// Безопасный режим расширения — ВЫКЛ.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Главная точка входа с формы «Заказ клиента».
Функция СформироватьКПиОтправитьВBitrix24(ЗаказКлиента) Экспорт
	
	Результат = НовыйРезультатОперации();
	
	Если НЕ ЗначениеЗаполнено(ЗаказКлиента) Тогда
		Результат.ТекстОшибки = "Не указан заказ клиента.";
		ЗаписатьВЖурнал("Ошибка", Результат.ТекстОшибки, ЗаказКлиента);
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		ДанныеПечати = Б24КП_ПечатьСервер.СформироватьКоммерческоеПредложение(ЗаказКлиента);
	Исключение
		Инфо = ИнформацияОбОшибке();
		Результат.ТекстОшибки = "Не удалось сформировать PDF коммерческого предложения: "
			+ КраткоеПредставлениеОшибки(Инфо);
		ЗаписатьВЖурнал("Ошибка", Результат.ТекстОшибки + Символы.ПС
			+ ПодробноеПредставлениеОшибки(Инфо), ЗаказКлиента);
		Возврат Результат;
	КонецПопытки;
	
	Результат.ПечатнаяФорма = ДанныеПечати.ПечатнаяФорма;
	Результат.НазваниеПечатнойФормы = ДанныеПечати.НазваниеПечатнойФормы;
	Результат.PDFСформирован = Истина;

	// Стадия «Смета/КП» на заказе и в B24
	Б24КП_УстановитьСтадиюСметаКП(ЗаказКлиента);
	
	ИНН = ПолучитьИННКонтрагентаЗаказа(ЗаказКлиента);
	ЕстьИНН = ЗначениеЗаполнено(СокрЛП(ИНН));
	ЗаказСвязанСоСделкой = Б24КП_ИнтеграцияB24.ЗаказСвязанСоСделкойB24(ЗаказКлиента);
	
	Попытка
		
		// Частное лицо без ИНН, но заказ уже привязан к сделке — как счёт, в таймлайн существующей сделки.
		Если ЗаказСвязанСоСделкой ИЛИ ЕстьИНН Тогда
			РезультатB24 = Б24КП_ИнтеграцияB24.ОтправитьКПВСуществующуюСделку(
				ЗаказКлиента,
				Результат.ПечатнаяФорма,
				Результат.НазваниеПечатнойФормы);
		Иначе
			РезультатB24 = Б24КП_ИнтеграцияB24.СоздатьСделкуИОтправитьКП(
				ЗаказКлиента,
				Результат.ПечатнаяФорма,
				Результат.НазваниеПечатнойФормы);
		КонецЕсли;
		
	Исключение
		
		Инфо = ИнформацияОбОшибке();
		Результат.ТекстОшибки = "Ошибка Bitrix24: " + КраткоеПредставлениеОшибки(Инфо);
		Результат.ТекстСообщения = "КП сформировано локально, но отправка в Bitrix24 не выполнена. "
			+ Результат.ТекстОшибки;
		ЗаписатьВЖурнал("Ошибка", Результат.ТекстОшибки + Символы.ПС
			+ ПодробноеПредставлениеОшибки(Инфо), ЗаказКлиента);
		Возврат Результат;
		
	КонецПопытки;
	
	Результат.СозданаНоваяСделка = РезультатB24.СозданаНоваяСделка;
	Результат.IDСделкиB24 = РезультатB24.IDСделкиB24;
	
	Если РезультатB24.Успех Тогда
		
		Результат.Успех = Истина;
		
		Если Результат.СозданаНоваяСделка Тогда
			Результат.ТекстСообщения = СтрШаблон(
				"КП сформировано. Создана новая сделка Bitrix24 (ID %1), PDF добавлен в таймлайн.",
				Результат.IDСделкиB24);
		Иначе
			Результат.ТекстСообщения = "КП сформировано и отправлено в таймлайн существующей сделки Bitrix24"
				+ ?(ЗначениеЗаполнено(Результат.IDСделкиB24), " (ID " + Результат.IDСделкиB24 + ")", "") + ".";
		КонецЕсли;
		
		ЗаписатьВЖурнал("Успех", Результат.ТекстСообщения, ЗаказКлиента);
		
	Иначе
		
		Результат.ТекстОшибки = РезультатB24.ТекстОшибки;
		Результат.ТекстСообщения = "КП сформировано локально, но отправка в Bitrix24 не выполнена. "
			+ Результат.ТекстОшибки;
		ЗаписатьВЖурнал("Ошибка", Результат.ТекстСообщения, ЗаказКлиента);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// ИНН контрагента заказа. Источник: Справочник.Контрагенты.ИНН
Функция ПолучитьИННКонтрагентаЗаказа(ЗаказКлиента) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ЗаказКлиента) Тогда
		Возврат "";
	КонецЕсли;
	
	Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаказКлиента, "Контрагент");
	
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат СокрЛП(Строка(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент, "ИНН")));
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйРезультатОперации()
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("ТекстСообщения", "");
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("СозданаНоваяСделка", Ложь);
	Результат.Вставить("IDСделкиB24", "");
	Результат.Вставить("ПечатнаяФорма", Неопределено);
	Результат.Вставить("НазваниеПечатнойФормы", "");
	Результат.Вставить("PDFСформирован", Ложь);
	
	Возврат Результат;
	
КонецФункции

Процедура Б24КП_УстановитьСтадиюСметаКП(ЗаказСсылка)

	Если НЕ ЗначениеЗаполнено(ЗаказСсылка) Тогда
		Возврат;
	КонецЕсли;

	СтатусКП = Б24КП_СтатусСметаКП();
	Если НЕ ЗначениеЗаполнено(СтатусКП) Тогда
		Возврат;
	КонецЕсли;

	ТекущийСтатус = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаказСсылка, "Б24Д_Статус");
	Если ТекущийСтатус <> СтатусКП Тогда

		ЗаказОбъект = ЗаказСсылка.ПолучитьОбъект();
		Если ЗаказОбъект = Неопределено Тогда
			Возврат;
		КонецЕсли;

		ЗаказОбъект.Б24Д_Статус = СтатусКП;
		ЗаказОбъект.Записать(РежимЗаписиДокумента.Запись);

	ИначеЕсли Метаданные.ОбщиеМодули.Найти("Б24_СинхронизацияСервер") <> Неопределено Тогда

		МодульСинх = ОбщегоНазначения.ОбщийМодуль("Б24_СинхронизацияСервер");
		МодульСинх.СинхронизироватьРегистрПоСтадииЗаказа(ЗаказСсылка);

	КонецЕсли;

КонецПроцедуры

Функция Б24КП_СтатусСметаКП()

	Попытка
		Возврат Перечисления.СтатусыЗаказовКлиентов.Б24_СметаКП;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Процедура ЗаписатьВЖурнал(УровеньСтрокой, Комментарий, Данные = Неопределено)
	
	Если УровеньСтрокой = "Ошибка" Тогда
		Уровень = УровеньЖурналаРегистрации.Ошибка;
	ИначеЕсли УровеньСтрокой = "Предупреждение" Тогда
		Уровень = УровеньЖурналаРегистрации.Предупреждение;
	Иначе
		Уровень = УровеньЖурналаРегистрации.Информация;
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации(
		"Б24КП.СформироватьКП",
		Уровень,
		Метаданные.Документы.ЗаказКлиента,
		Данные,
		Комментарий);
	
КонецПроцедуры

#КонецОбласти
