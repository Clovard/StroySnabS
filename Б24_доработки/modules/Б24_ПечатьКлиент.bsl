///////////////////////////////////////////////////////////////////////////////////////////////////////
// Общий модуль Б24_ПечатьКлиент (Клиент).
// Блок счёта с факсимиле без даты — до открытия окна печати.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Команда из меню «Печать» на форме заказа.
Функция ЭтоПечатьФаксимилеСчета(Команда, ДополнительныеПараметры) Экспорт

	Возврат Б24_ТекстСодержитФаксимиле(Б24_ТекстКомандыПечати(Команда, ДополнительныеПараметры));

КонецФункции

// Описание команды из УправлениеПечатьюКлиент.ВыполнитьКомандуПечати.
Функция ЭтоОписаниеПечатиФаксимилеСчета(ОписаниеКоманды) Экспорт

	Возврат Б24_ТекстСодержитФаксимиле(Б24_ТекстОписанияПечати(ОписаниеКоманды));

КонецФункции

Функция ТекстОшибкиДатыПередФаксимиле(ЗаказСсылка) Экспорт

	Если НЕ ЗначениеЗаполнено(ЗаказСсылка) Тогда
		Возврат "Сначала запишите заказ клиента.";
	КонецЕсли;

	Возврат Б24_СчетВызовСервера.ТекстОшибкиДатыПередСчетомСФаксимиле(ЗаказСсылка);

КонецФункции

Функция ЗаказСсылкаИзФормыПечати(Форма, ОписаниеКоманды) Экспорт

	Если Форма <> Неопределено Тогда

		Попытка

			Если ЗначениеЗаполнено(Форма.Объект.Ссылка) Тогда
				Возврат Форма.Объект.Ссылка;
			КонецЕсли;

		Исключение
		КонецПопытки;

	КонецЕсли;

	Если ОписаниеКоманды <> Неопределено
		И ТипЗнч(ОписаниеКоманды) = Тип("Структура")
		И ОписаниеКоманды.Свойство("ОбъектыПечати") Тогда

		Объекты = ОписаниеКоманды.ОбъектыПечати;

		Если Объекты <> Неопределено И Объекты.Количество() > 0 Тогда

			Элемент = Объекты[0];

			Если ТипЗнч(Объекты) = Тип("СписокЗначений") Тогда
				ОбъектПечати = Элемент.Значение;
			Иначе
				ОбъектПечати = Элемент;
			КонецЕсли;

			Возврат Б24_СчетВызовСервера.ЗаказКлиентаПоОбъектуПечати(ОбъектПечати);

		КонецЕсли;

	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Б24_ТекстКомандыПечати(Команда, ДополнительныеПараметры)

	Части = Новый Массив;

	Если Команда <> Неопределено Тогда

		Попытка
			Части.Добавить(Строка(Команда.Имя));
		Исключение
		КонецПопытки;

		Попытка
			Части.Добавить(Строка(Команда.Заголовок));
		Исключение
		КонецПопытки;

	КонецЕсли;

	Если ДополнительныеПараметры <> Неопределено
		И ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("ИменаМакетов") Тогда

		Части.Добавить(Строка(ДополнительныеПараметры.ИменаМакетов));

	КонецЕсли;

	Возврат СтрСоединить(Части, " ");

КонецФункции

Функция Б24_ТекстОписанияПечати(ОписаниеКоманды)

	Если ОписаниеКоманды = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Части = Новый Массив;

	Если ТипЗнч(ОписаниеКоманды) = Тип("Структура") Тогда

		Для Каждого КлючИЗначение Из ОписаниеКоманды Цикл
			Части.Добавить(Строка(КлючИЗначение.Значение));
		КонецЦикла;

	Иначе
		Части.Добавить(Строка(ОписаниеКоманды));
	КонецЕсли;

	Возврат СтрСоединить(Части, " ");

КонецФункции

Функция Б24_ТекстСодержитФаксимиле(Текст)

	ТекстНРег = НРег(СокрЛП(Текст));

	Возврат СтрНайти(ТекстНРег, "факсимил") > 0
		Или СтрНайти(ТекстНРег, "facsimile") > 0;

КонецФункции

#КонецОбласти
